<Window x:Class="WinPieGestures.TextResultWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontSize="14" Width="760" Height="520" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="ButtonDefaultBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ButtonDefaultFgBrush" Color="#334155"/>
        <SolidColorBrush x:Key="ButtonDefaultBorderBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="ButtonHoverBgBrush" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="ItemHoverBrush" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="NavTabActiveBgBrush" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
        <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
        <Style x:Key="ResultButton" TargetType="Button">
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="8,4,0,0"/>
            <Setter Property="Background" Value="{DynamicResource ButtonDefaultBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonDefaultFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonDefaultBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBgBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                <Setter TargetName="Frame" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                    <Condition Property="Tag" Value="Primary"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResultPrimaryButton" TargetType="Button" BasedOn="{StaticResource ResultButton}">
            <Setter Property="Tag" Value="Primary"/>
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ResultSelectorStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="SelectFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="12,8" Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center"/>
                                    <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource TextPrimaryBrush}"
                                          StrokeThickness="1.5" Width="8" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                                <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="4">
                                    <ScrollViewer MaxHeight="240"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SelectFrame" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectFrame" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ItemHoverBrush}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource NavTabActiveBgBrush}"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="ResultRoot" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel x:Name="ResultHeader" Margin="0,0,0,20">
            <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="SummaryText" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
        <ComboBox x:Name="ResultSelector" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,16"
                  Style="{StaticResource ResultSelectorStyle}" SelectionChanged="ResultSelector_SelectionChanged"
                  AutomationProperties.AutomationId="TextResultSelector">
            <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <Grid x:Name="ResultsBody" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="220"/>
                <ColumnDefinition x:Name="GapColumn" Width="20"/>
                <ColumnDefinition x:Name="DetailColumn" Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition x:Name="TopRow" Height="*"/><RowDefinition x:Name="BottomRow" Height="0"/></Grid.RowDefinitions>
            <Grid x:Name="ResultSidebar">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="ListHeadingText" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <ListBox x:Name="ResultList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource TextPrimaryBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ResultList_SelectionChanged" AutomationProperties.AutomationId="TextResultList">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Summary}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           MaxHeight="40" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <Grid x:Name="ResultDetails" Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="ContentLabelText" FontWeight="SemiBold"/>
                    <TextBlock x:Name="FormatText" Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,0,0,0"/>
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}">
                    <TextBox x:Name="ResultContent" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0"
                             Margin="2" Padding="12" VerticalScrollBarVisibility="Auto" Background="Transparent"
                             Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.AutomationId="TextResultContent"/>
                </Border>
                <StackPanel x:Name="ResultAddress" Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock x:Name="AddressText" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ActionHintText" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Border x:Name="ResultFooter" Grid.Row="3" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="KeyboardHintText" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <WrapPanel Grid.Row="1" HorizontalAlignment="Right">
                    <Button x:Name="CopyButton" Style="{StaticResource ResultPrimaryButton}" Click="Copy_Click" IsDefault="True"
                            AutomationProperties.AutomationId="TextResultCopy"/>
                    <Button x:Name="OpenButton" Style="{StaticResource ResultButton}" Click="Open_Click" ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.AutomationId="TextResultOpen"/>
                    <Button x:Name="CloseButton" Style="{StaticResource ResultButton}" Click="Close_Click" IsCancel="True"
                            AutomationProperties.AutomationId="TextResultClose"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
